@charset "utf-8";

@font-face { font-family: "Droid Sans Mono"; src: url("../assets/fonts/c194=
30005c13bc31e6af52c5ccb78159.woff") format("woff"); font-weight: 400; font-=
style: normal; font-display: swap; }

body, html { margin: 0px; padding: 0px; width: 100%; height: 100%; overflow=
: hidden; }

body, button, html { font-family: "Euclid Circular A", sans-serif; font-sty=
le: normal; }

button { outline: none; }

.clearfix::after, .clearfix::before { content: " "; display: table; }

.clearfix::after { clear: both; }

button { cursor: pointer; }

.svg path { opacity: 1; fill-opacity: 1; stroke-opacity: 1; }

.button:disabled, button[disabled] { cursor: not-allowed; }

.container { width: 100vw; height: 100vh; overflow: hidden; }

.wrapper { background: rgb(245, 245, 245); display: flex; flex-direction: c=
olumn; height: 100%; width: 100%; max-height: 100%; }

.main-content-wrapper, .split-panes-wrapper { flex: 1 1 0%; display: flex; =
min-height: 0px; min-width: 0px; height: 100%; width: 100%; }

@media screen and (min-width: 800px) {
  .editor-workspace-wrapper { width: calc(100% - 56px); flex-grow: 1; displ=
ay: flex; flex-direction: column; height: 100%; }
}

.editor-workspace-wrapper { height: 100%; width: 100%; min-height: 0px; min=
-width: 0px; }

.compiler-header-ad { padding: 4px 0px; margin: auto; display: none; }

#feedback-desktop { display: none; }

#feedback-desktop svg, #feedback-mobile svg { transform: rotateY(-180deg); =
width: 20px; height: 20px; }

#feedback-desktop svg path, #feedback-mobile svg path { stroke: rgb(5, 86, =
243); }

.header { display: flex; justify-content: space-between; background-color: =
rgb(255, 255, 255); height: 51px; }

.logo-wrapper, .mobile-top-bar { background: rgb(255, 255, 255); }

.logo-wrapper { display: flex; align-items: center; color: rgba(37, 38, 94,=
 0.7); }

.logo-title-wrapper { margin: 0px; display: inline-block; }

.logo-title-wrapper .logo-sub-title-wrapper { font-size: 14px; font-weight:=
 400; }

.logo-link { display: flex; flex-direction: column; margin-left: 16px; }

